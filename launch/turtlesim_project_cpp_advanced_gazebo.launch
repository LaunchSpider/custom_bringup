<launch>
    <set_env name = "TURTLEBOT3_MODEL" value="waffle" />
    <include file="$(find-pkg-share turtlebot3_gazebo)/launch/empty_world.launch.py" />
    <node pkg="rclcpp_components" exec="component_container_mt" name="turtle_container_gazebo" />
    <executable cmd="ros2 component load /turtle_container_gazebo turtlesim_project_cpp_advanced
                          turtle_controller_gazebo::TurtleBotController -r __node:=turtle_controller_1"
              output="screen" />
    <node pkg="lifecycle_py" exec="lifecycle_node_manager">
        <param name="managed_node_name" value="turtle_controller_1" /> 
    </node>
</launch>